```html
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>BotIA — Seu assistente inteligente</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #101018;
      color: #fff;
      height: 100vh;
      display: flex;
    }

    aside {
      width: 250px;
      background: #171722;
      padding: 20px;
      border-right: 1px solid #29293b;
    }

    .logo {
      font-size: 28px;
      font-weight: bold;
      margin-bottom: 30px;
      color: #a78bfa;
    }

    button {
      cursor: pointer;
      border: none;
      border-radius: 10px;
      padding: 12px;
      font-size: 14px;
      color: white;
      background: #29293b;
    }

    button:hover {
      filter: brightness(1.2);
    }

    .new-chat {
      width: 100%;
      background: linear-gradient(90deg, #7c3aed, #2563eb);
      margin-bottom: 12px;
    }

    main {
      flex: 1;
      display: flex;
      flex-direction: column;
      min-width: 0;
    }

    header {
      padding: 20px;
      border-bottom: 1px solid #29293b;
      font-size: 18px;
      font-weight: bold;
    }

    #chat {
      flex: 1;
      overflow-y: auto;
      padding: 25px;
    }

    .welcome {
      text-align: center;
      margin: 12vh auto 0;
      max-width: 550px;
    }

    .welcome h1 {
      font-size: 36px;
      background: linear-gradient(90deg, #a78bfa, #60a5fa);
      color: transparent;
      background-clip: text;
    }

    .welcome p {
      color: #aaaabb;
      line-height: 1.6;
    }

    .message {
      max-width: 750px;
      margin: 18px auto;
      padding: 15px 18px;
      border-radius: 14px;
      line-height: 1.6;
      white-space: pre-wrap;
      overflow-wrap: anywhere;
    }

    .user {
      background: #292442;
    }

    .assistant {
      background: #1b1b29;
      border: 1px solid #303047;
    }

    .composer {
      width: min(850px, 95%);
      margin: 0 auto 20px;
      padding: 12px;
      background: #1b1b29;
      border: 1px solid #39394d;
      border-radius: 18px;
    }

    textarea {
      width: 100%;
      resize: vertical;
      min-height: 55px;
      max-height: 180px;
      background: transparent;
      color: white;
      border: none;
      outline: none;
      padding: 10px;
      font: inherit;
    }

    .tools {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      align-items: center;
    }

    .thinking.active {
      background: #6d28d9;
    }

    .image-button {
      background: #164e63;
    }

    .send {
      margin-left: auto;
      background: #7c3aed;
      min-width: 70px;
    }

    .status {
      color: #9292a8;
      font-size: 12px;
      text-align: center;
      padding: 0 10px 12px;
    }

    @media (max-width: 650px) {
      aside {
        display: none;
      }

      .welcome h1 {
        font-size: 29px;
      }

      #chat {
        padding: 12px;
      }
    }
  </style>
</head>

<body>
  <aside>
    <div class="logo">✦ BotIA</div>
    <button class="new-chat" id="newChat">+ Nova conversa</button>
    <p style="color:#9292a8;font-size:13px;">
      Seu espaço de inteligência artificial.
    </p>
  </aside>

  <main>
    <header>BotIA <span style="color:#a78bfa;">✦</span></header>

    <section id="chat" aria-live="polite">
      <div class="welcome" id="welcome">
        <h1>O que vamos descobrir hoje?</h1>
        <p>
          Pergunte, explore ideias, aprenda coisas novas
          ou crie algo incrível com o BotIA.
        </p>
      </div>
    </section>

    <section class="composer">
      <textarea
        id="prompt"
        placeholder="Pergunte qualquer coisa..."
        aria-label="Escreva sua mensagem"
      ></textarea>

      <div class="tools">
        <button class="thinking" id="thinking" aria-pressed="false">
          🧠 Pensar mais: OFF
        </button>

        <button class="image-button" id="generateImage">
          🎨 Gerar imagens
        </button>

        <button class="send" id="send">Enviar ↑</button>
      </div>
    </section>

    <div class="status" id="status">
      Interface inicial · IA será conectada na próxima etapa
    </div>
  </main>

  <script>
    const chat = document.getElementById("chat");
    const promptInput = document.getElementById("prompt");
    const welcome = document.getElementById("welcome");
    const thinkingButton = document.getElementById("thinking");
    const status = document.getElementById("status");

    let thinking = false;

    thinkingButton.addEventListener("click", () => {
      thinking = !thinking;

      thinkingButton.classList.toggle("active", thinking);
      thinkingButton.setAttribute("aria-pressed", String(thinking));
      thinkingButton.textContent = thinking
        ? "🧠 Pensar mais: ON"
        : "🧠 Pensar mais: OFF";
    });

    function addMessage(text, role) {
      const message = document.createElement("div");
      message.className = "message " + role;
      message.textContent = text;
      chat.appendChild(message);
      chat.scrollTop = chat.scrollHeight;
    }

    document.getElementById("send").addEventListener("click", sendMessage);

    promptInput.addEventListener("keydown", (event) => {
      if (event.key === "Enter" && !event.shiftKey) {
        event.preventDefault();
        sendMessage();
      }
    });

    function sendMessage() {
      const text = promptInput.value.trim();

      if (!text) return;

      welcome?.remove();
      addMessage(text, "user");
      promptInput.value = "";

      addMessage(
        "A interface do BotIA está funcionando! 🤖\n\n" +
        "Ainda precisamos conectar uma IA real para responder às suas perguntas.",
        "assistant"
      );

      status.textContent = thinking
        ? "Modo Pensar mais selecionado · Aguardando conexão com a IA"
        : "Aguardando conexão com a IA";
    }

    document.getElementById("generateImage").addEventListener("click", () => {
      status.textContent =
        "A geração de imagens será ativada quando conectarmos a API.";
      promptInput.focus();
      promptInput.placeholder = "Descreva a imagem que deseja criar...";
    });

    document.getElementById("newChat").addEventListener("click", () => {
      chat.innerHTML = `
        <div class="welcome" id="welcome">
          <h1>O que vamos descobrir hoje?</h1>
          <p>Pergunte, explore ideias, aprenda coisas novas
          ou crie algo incrível com o BotIA.</p>
        </div>
      `;

      status.textContent = "Nova conversa iniciada";
      promptInput.value = "";
      promptInput.placeholder = "Pergunte qualquer coisa...";
    });
  </script>
</body>
</html>
```
